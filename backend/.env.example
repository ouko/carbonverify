# CarbonVerify Backend Environment Variables
# Copy to .env and fill in all required values

# === REQUIRED ===

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/carbonverify

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Secret (generate: openssl rand -hex 32)
SECRET_KEY=

# S3 Bucket for file uploads
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Frontend URL (for CORS)
FRONTEND_URL=https://your-domain.com

# PII Encryption Key (generate: python3 -c "import secrets; print(secrets.token_hex(32))")
# Must be exactly 64 hexadecimal characters (32 bytes).
ENCRYPTION_KEY_HEX=

# === OPTIONAL ===

# Environment
ENVIRONMENT=production
LOG_LEVEL=INFO

# JWT Previous Secret (for zero-downtime rotation)
SECRET_KEY_PREVIOUS=

# Read Replica (optional)
# DATABASE_READ_REPLICA_URL=postgresql+asyncpg://user:password@replica-host:5432/carbonverify

# Celery
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

# IoT Webhook
IOT_WEBHOOK_API_KEY=

# Kimi AI (optional)
# Agents, RAG, and AI evaluation degrade to deterministic fallbacks when no key is configured.
KIMI_API_KEY=
KIMI_API_BASE=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# Methodology knowledge base embeddings (optional)
# OpenAI-compatible /embeddings endpoint. Empty → deterministic offline
# LocalHashEmbedder (no external calls, lower retrieval quality).
KNOWLEDGE_EMBEDDER_URL=
KNOWLEDGE_EMBEDDER_MODEL=
KNOWLEDGE_EMBEDDER_API_KEY=

# Radix DLT (optional)
RADIX_ENABLED=false
RADIX_GATEWAY_URL=https://mainnet.radixdlt.com
RADIX_NETWORK_ID=1
RADIX_PRIVATE_KEY_HEX=
RADIX_ACCOUNT_ADDRESS=

# Lead Scraper
LEAD_SCRAPER_MODE=demo
LEAD_SCRAPER_RATE_LIMIT_RPS=0.5
LEAD_SCRAPER_REQUEST_TIMEOUT=30
LEAD_SCRAPER_MAX_RETRIES=3
LEAD_SCRAPER_RETRY_DELAY=5
PROXY_URL=
SCRAPER_FORCE_HEADLESS=false
# Comma-separated user agents for rotation
SCRAPER_USER_AGENTS=

# Pre-audit pipeline
# Set PRE_AUDIT_PENDING_ONLY=true to auto-convert only leads whose registry status
# indicates they are under validation/verification/certification.
PRE_AUDIT_PENDING_ONLY=false
PRE_AUDIT_PENDING_STATUSES=under_validation,under_verification,under_certification

# Human escalation notifications (autonomous layer; optional)
# Adapters are log-only when these are empty. Comma-separated operator inboxes:
ESCALATION_NOTIFY_EMAIL=
# E.164 operator number for P0 WhatsApp alerts (also needs WHATSAPP_ACCESS_TOKEN
# and WHATSAPP_PHONE_NUMBER_ID below):
ESCALATION_NOTIFY_WHATSAPP=
# E.164 operator number for P0 SMS alerts (also needs ESCALATION_SMS_WEBHOOK_URL):
ESCALATION_NOTIFY_SMS=
# Pluggable SMS provider HTTP hook (POST {"to": ..., "message": ...}):
ESCALATION_SMS_WEBHOOK_URL=
# Meta WhatsApp Business API credentials used by the WhatsApp escalation channel:
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Pre-deploy gate (scripts/pre_deploy_check.py; optional)
# Defaults: base URL http://localhost:8000, no auth token.
DEPLOY_CHECK_BASE_URL=
DEPLOY_CHECK_TOKEN=

# ClamAV (optional — leave empty to skip virus scanning)
CLAMAV_SOCKET_PATH=
CLAMAV_HOST=
CLAMAV_PORT=3310

# Compliance
BREACH_NOTIFICATION_SLA_HOURS=72
DSR_RESPONSE_SLA_DAYS=30
DATA_RETENTION_YEARS_RAW_PHOTOS=7
