# CarbonVerify Backend Environment Variables
# Copy to .env and fill in all required values

# === REQUIRED ===

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/carbonverify

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Secret (generate: openssl rand -hex 32)
SECRET_KEY=

# S3 Bucket for file uploads
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Frontend URL (for CORS)
FRONTEND_URL=https://your-domain.com

# PII Encryption Key (generate: python -c "import secrets; print(secrets.token_hex(32))")
ENCRYPTION_KEY_HEX=

# === OPTIONAL ===

# Environment
ENVIRONMENT=production
LOG_LEVEL=INFO

# JWT Previous Secret (for zero-downtime rotation)
SECRET_KEY_PREVIOUS=

# Read Replica (optional)
# DATABASE_READ_REPLICA_URL=postgresql+asyncpg://user:password@replica-host:5432/carbonverify

# Celery
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

# IoT Webhook
IOT_WEBHOOK_API_KEY=

# Kimi AI (optional)
KIMI_API_KEY=
KIMI_API_BASE=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# Radix DLT (optional)
RADIX_ENABLED=false
RADIX_GATEWAY_URL=https://mainnet.radixdlt.com
RADIX_NETWORK_ID=1
RADIX_PRIVATE_KEY_HEX=
RADIX_ACCOUNT_ADDRESS=

# Lead Scraper
LEAD_SCRAPER_MODE=demo
LEAD_SCRAPER_RATE_LIMIT_RPS=0.5
LEAD_SCRAPER_REQUEST_TIMEOUT=30
LEAD_SCRAPER_MAX_RETRIES=3
LEAD_SCRAPER_RETRY_DELAY=5
PROXY_URL=
SCRAPER_FORCE_HEADLESS=false
# Comma-separated user agents for rotation
SCRAPER_USER_AGENTS=

# ClamAV (optional — leave empty to skip virus scanning)
CLAMAV_SOCKET_PATH=
CLAMAV_HOST=
CLAMAV_PORT=3310

# Compliance
BREACH_NOTIFICATION_SLA_HOURS=72
DSR_RESPONSE_SLA_DAYS=30
DATA_RETENTION_YEARS_RAW_PHOTOS=7
