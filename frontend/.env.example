# Frontend environment variables
# Copy to .env.local for local dev, set in Vercel dashboard for production

# Backend API URL.
# For production / staging, set this to the public API origin, e.g.:
#   VITE_API_URL=https://api.carbonverify.io
# For local hybrid development, leave this UNSET/EMPTY so the Vite dev-server
# proxy forwards API calls to the FastAPI backend on the same origin. Setting
# a direct 127.0.0.1:8001 URL here causes cross-origin requests and can trigger
# CORS or timeout issues in the browser.
VITE_API_URL=https://your-backend-domain.com

# WebSocket URL (optional, defaults to wss://your-backend-domain.com/ws/notifications)
# VITE_WS_URL=wss://your-backend-domain.com/ws/notifications
