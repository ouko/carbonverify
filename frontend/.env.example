# Frontend environment variables
# Copy to .env.local for local dev, set in Vercel dashboard for production

# Backend API URL (required)
# Example: https://api.carbonverify.io
VITE_API_URL=https://your-backend-domain.com

# WebSocket URL (optional, defaults to wss://your-backend-domain.com/ws/notifications)
# VITE_WS_URL=wss://your-backend-domain.com/ws/notifications
