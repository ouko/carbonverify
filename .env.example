# Database
POSTGRES_USER=carbonverify
POSTGRES_PASSWORD=
POSTGRES_DB=carbonverify
DATABASE_URL=postgresql+asyncpg://carbonverify:@db:5432/carbonverify

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# JWT
SECRET_KEY=
SECRET_KEY_PREVIOUS=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=carbonverify-uploads

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:5173
TRUSTED_PROXIES=

# IoT Webhook
IOT_WEBHOOK_API_KEY=
IOT_WEBHOOK_SECRET=

# WhatsApp
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Frontend build-time vars (used by Vite during Docker build)
# Leave empty to use same-origin relative requests through the reverse proxy.
VITE_API_URL=
VITE_WS_URL=

# MFA
MFA_ISSUER_NAME=CarbonVerify
MFA_REQUIRED_ROLES=admin,operator

# Session
SESSION_INACTIVITY_TIMEOUT_MINUTES=30

# Encryption
ENCRYPTION_KEY_HEX=
DATA_RETENTION_YEARS_RAW_PHOTOS=7

# Radix DLT
RADIX_GATEWAY_URL=https://mainnet.radixdlt.com
RADIX_NETWORK_ID=1
RADIX_PRIVATE_KEY_HEX=
RADIX_ACCOUNT_ADDRESS=
RADIX_ENABLED=False

# ClamAV
CLAMAV_SOCKET_PATH=
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Compliance
BREACH_NOTIFICATION_SLA_HOURS=72
DSR_RESPONSE_SLA_DAYS=30

# Lead Intelligence Engine
LEAD_SCRAPER_MODE=demo
LEAD_SCRAPER_RATE_LIMIT_RPS=0.5
LEAD_SCRAPER_REQUEST_TIMEOUT=30
LEAD_SCRAPER_MAX_RETRIES=3
LEAD_SCRAPER_RETRY_DELAY=5
PROXY_URL=
SCRAPER_FORCE_HEADLESS=False
SCRAPER_USER_AGENTS=

# Kimi API (Moonshot AI)
KIMI_API_KEY=
KIMI_API_BASE=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# Database read replica (optional)
DATABASE_READ_REPLICA_URL=

# SIEM streaming
SIEM_ENDPOINT=
SIEM_TOKEN=
SIEM_SOURCE=carbonverify
SIEM_INDEX=main

# Email — AWS SES is preferred; SMTP is fallback
EMAIL_PROVIDER=ses
AWS_SES_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=True

# OAuth / SSO
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_OKTA_CLIENT_ID=
OAUTH_OKTA_CLIENT_SECRET=
OAUTH_OKTA_DOMAIN=

# Kenya National Carbon Registry
KENYA_NATIONAL_REGISTRY_BASE_URL=
KENYA_NATIONAL_REGISTRY_API_KEY=
