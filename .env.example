# Database
POSTGRES_USER=carbonverify
POSTGRES_PASSWORD=carbonverify_secret
POSTGRES_DB=carbonverify
DATABASE_URL=postgresql+asyncpg://carbonverify:carbonverify_secret@db:5432/carbonverify

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
SECRET_KEY=super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=carbonverify-uploads

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:5173

# IoT Webhook
IOT_WEBHOOK_API_KEY=change-me-in-production

# WhatsApp
WHATSAPP_VERIFY_TOKEN=change-me-in-production

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Frontend build-time vars (used by Vite during Docker build)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/notifications

# MFA
MFA_ISSUER_NAME=CarbonVerify
MFA_REQUIRED_ROLES=admin,operator

# Session
SESSION_INACTIVITY_TIMEOUT_MINUTES=30

# Encryption
ENCRYPTION_KEY_HEX=
DATA_RETENTION_YEARS_RAW_PHOTOS=7

# Radix DLT
RADIX_GATEWAY_URL=https://mainnet.radixdlt.com
RADIX_NETWORK_ID=1
RADIX_PRIVATE_KEY_HEX=
RADIX_ACCOUNT_ADDRESS=
RADIX_ENABLED=False

# ClamAV
CLAMAV_SOCKET_PATH=
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Compliance
BREACH_NOTIFICATION_SLA_HOURS=72
DSR_RESPONSE_SLA_DAYS=30

# Lead Intelligence Engine
LEAD_SCRAPER_MODE=demo
LEAD_SCRAPER_RATE_LIMIT_RPS=0.5
LEAD_SCRAPER_REQUEST_TIMEOUT=30
LEAD_SCRAPER_MAX_RETRIES=3
LEAD_SCRAPER_RETRY_DELAY=5
PROXY_URL=
SCRAPER_FORCE_HEADLESS=False
SCRAPER_USER_AGENTS=

# Kimi AI
KIMI_API_KEY=
KIMI_API_BASE=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# Database read replica (optional)
DATABASE_READ_REPLICA_URL=
